{
  "name": "padcode",
  "version": "0.1.0-rc.10",
  "private": true,
  "license": "MIT",
  "description": "Control your own AI coding agent from the terminal with a gamepad",
  "keywords": [
    "gamepad",
    "controller",
    "dualshock",
    "dualsense",
    "cli",
    "terminal",
    "coding-agent",
    "claude-code",
    "codex",
    "accessibility",
    "macos"
  ],
  "homepage": "https://github.com/thinxpro/padcode#readme",
  "bugs": {
    "url": "https://github.com/thinxpro/padcode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thinxpro/padcode.git"
  },
  "author": "thinxpro (https://github.com/thinxpro)",
  "type": "module",
  "bin": {
    "padcode": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test --import ./test/no-child-coverage.mjs --test-concurrency=1 test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='dist/**' --import ./test/no-child-coverage.mjs --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm run build:native && npm run build:pty && npm run test:coverage",
    "dev": "npm run build && node dist/cli.js",
    "gallery": "npm run build && node scripts/tui-gallery.mjs",
    "build:pty": "node scripts/build-pty.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "node-pty": "1.1.0",
    "typescript": "5.9.3"
  }
}
