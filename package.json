{
  "name": "padcode",
  "version": "0.1.0-rc.9",
  "private": true,
  "license": "MIT",
  "description": "Gamepad controls for your own coding agent — terminal development build",
  "type": "module",
  "bin": {
    "padcode": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "test": "node --test --import ./test/no-child-coverage.mjs --test-concurrency=1 test/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='dist/**' --import ./test/no-child-coverage.mjs --test-concurrency=1 test/*.test.mjs",
    "check": "npm run typecheck && npm run build && npm run build:native && npm run build:pty && npm run test:coverage",
    "dev": "npm run build && node dist/cli.js",
    "build:pty": "node scripts/build-pty.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "node-pty": "1.1.0",
    "typescript": "5.9.3"
  }
}
